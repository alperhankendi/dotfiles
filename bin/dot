#!/usr/bin/env bash
# dot — the single entry point for this dotfiles repository.
# See PLAN.md section 5 for the command contract.
set -euo pipefail

# shellcheck source=scripts/lib.sh
. "$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." && pwd)/scripts/lib.sh"

# shellcheck source=scripts/link.sh
. "$DOT_ROOT/scripts/link.sh"

usage() {
  cat <<'EOF'
Usage: dot <command> [options]

Commands:
  bootstrap [--yes] [--skip-macos] [--skip-gui]
                      Full install on a fresh machine
  link [package...]   Symlink packages into $HOME (default: all)
  unlink [package...] Remove those symlinks
  brew [--gui]        Install Homebrew packages
  macos               Apply macOS system defaults
  update              Update Homebrew, plugins, and runtimes
  doctor              Check that everything is in place
  help                Show this message
EOF
}

main() {
  local cmd="${1:-help}"
  [ "$#" -gt 0 ] && shift

  case "$cmd" in
    help | -h | --help) usage ;;
    doctor)
      bash "$DOT_ROOT/scripts/doctor.sh"
      ;;
    link)
      link_packages link "$@"
      ;;
    unlink)
      link_packages unlink "$@"
      ;;
    brew)
      have brew || die "Homebrew is missing — run: dot bootstrap"
      # Validate before installing, so a typo cannot half-install the machine.
      case "${1:-}" in
        "" | --gui) ;;
        *) die "unknown option for brew: $1 (expected --gui)" ;;
      esac
      brew bundle --file="$DOT_ROOT/homebrew/Brewfile"
      if [ "${1:-}" = "--gui" ]; then
        brew bundle --file="$DOT_ROOT/homebrew/Brewfile.gui"
      fi
      ;;
    macos)
      bash "$DOT_ROOT/macos/defaults.sh" "$@"
      ;;
    bootstrap)
      cmd_bootstrap "$@"
      ;;
    update)
      cmd_update "$@"
      ;;
    *)
      err "unknown command: $cmd"
      usage >&2
      exit 1
      ;;
  esac
}

cmd_bootstrap() {
  local assume_yes=0 skip_macos=0 skip_gui=0 dry_run=0

  while [ "$#" -gt 0 ]; do
    case "$1" in
      --yes) assume_yes=1 ;;
      --skip-macos) skip_macos=1 ;;
      --skip-gui) skip_gui=1 ;;
      --dry-run) dry_run=1 ;;
      *) err "unknown bootstrap option: $1"; exit 1 ;;
    esac
    shift
  done

  if [ "$dry_run" -eq 1 ]; then
    printf 'bootstrap would run these steps, in order:\n\n'
    # Generated from the section() calls in this function, so the preview
    # cannot drift from what the function actually does.
    awk '/^cmd_bootstrap\(\)/,/^}/' "$0" \
      | grep -oE 'section "[A-Za-z][^"]*"' \
      | sed 's/section "//; s/"$//' \
      | nl -w3 -s'. ' | sed 's/^/  /'
    printf '\nNothing has been done. Run without --dry-run to proceed.\n'
    return 0
  fi

  section "Xcode Command Line Tools"
  if xcode-select -p >/dev/null 2>&1; then
    info "already installed"
  else
    info "installing — follow the GUI prompt, then re-run this command"
    xcode-select --install
    exit 0
  fi

  # Two things need a person, and both are asked here, once, at the very
  # start, before Homebrew or anything else runs: the administrator password
  # (so Homebrew can create /opt/homebrew) and whether to apply macOS system
  # defaults, which are actually applied later, at step 11.
  #
  # Both open /dev/tty rather than checking stdin: the documented entry point
  # is `curl ... | bash`, where stdin is a pipe and `[ -t 0 ]` is always false
  # even with a terminal attached. Reading /dev/tty means both prompts still
  # appear under that pipe. CI has no controlling terminal, so the open fails
  # there and both are skipped — the safe direction.
  section "Up-front prompts"
  local have_tty=0
  if ( : </dev/tty ) 2>/dev/null; then
    have_tty=1
  fi

  if ! have brew; then
    if [ "$have_tty" -eq 1 ]; then
      info "Homebrew needs to create /opt/homebrew — asking for your password once"
      # SC2024: the concern is a file the invoking user cannot read being
      # opened without sudo's privileges. /dev/tty is the user's own
      # controlling terminal, already readable by them, so that concern does
      # not apply here.
      # shellcheck disable=SC2024
      sudo -v </dev/tty
      # Refresh in the background so it cannot expire mid-run.
      while true; do sudo -n true; sleep 60; kill -0 "$$" || exit; done 2>/dev/null &
    else
      info "no controlling terminal — Homebrew's own installer will ask for the password"
    fi
  fi

  local apply_macos_defaults=0 macos_defaults_skipped=0
  if [ "$skip_macos" -eq 1 ]; then
    info "macOS defaults: will skip (--skip-macos)"
  elif [ "$assume_yes" -eq 1 ]; then
    apply_macos_defaults=1
    info "macOS defaults: will apply at step 11 (--yes)"
  elif [ "$have_tty" -eq 1 ]; then
    printf 'Apply macOS system defaults later in this run? [y/N] '
    read -r macos_reply </dev/tty
    case "$macos_reply" in
      [yY] | [yY][eE][sS]) apply_macos_defaults=1 ;;
      *) apply_macos_defaults=0 ;;
    esac
  else
    info "no controlling terminal — macOS defaults will be skipped"
  fi

  section "Homebrew"
  if have brew; then
    info "already installed"
  else
    # NONINTERACTIVE stops the installer waiting for a RETURN keypress.
    NONINTERACTIVE=1 /bin/bash -c \
      "$(curl -fsSL https://raw.githubusercontent.com/Homebrew/install/HEAD/install.sh)"
  fi
  eval "$(/opt/homebrew/bin/brew shellenv)"

  section "Homebrew packages"
  brew bundle --file="$DOT_ROOT/homebrew/Brewfile"
  if [ "$skip_gui" -eq 0 ]; then
    brew bundle --file="$DOT_ROOT/homebrew/Brewfile.gui"
  else
    info "skipping GUI packages"
  fi

  section "Shell plugins"
  link_packages link sheldon
  sheldon lock

  section "Dotfiles"
  link_packages link

  section "Machine-local files"
  bootstrap_local_file "$DOT_ROOT/packages/git/.config/git/local.example" \
    "$HOME/.config/git/local"
  bootstrap_local_file "$DOT_ROOT/packages/zsh/.config/zsh/local.zsh.example" \
    "$HOME/.config/zsh/local.zsh"

  section "tmux plugins"
  if [ ! -d "$HOME/.config/tmux/plugins/tpm" ]; then
    git clone --depth 1 https://github.com/tmux-plugins/tpm \
      "$HOME/.config/tmux/plugins/tpm"
  fi
  if [ ! -d "$HOME/.config/tmux/plugins/catppuccin/tmux" ]; then
    mkdir -p "$HOME/.config/tmux/plugins/catppuccin"
    git clone --depth 1 -b v2.3.0 https://github.com/catppuccin/tmux.git \
      "$HOME/.config/tmux/plugins/catppuccin/tmux"
  fi
  "$HOME/.config/tmux/plugins/tpm/bin/install_plugins" || \
    warn "tmux plugin install reported a problem; run prefix+I inside tmux"

  section "Runtimes"
  mise install

  section "Neovim plugins"
  nvim --headless "+Lazy! sync" +qa || warn "nvim plugin sync reported a problem"

  # The question was already asked above, at the very start; this step only
  # acts on the answer, non-interactively, so it cannot stall twenty-plus
  # minutes into an unattended run.
  section "macOS defaults"
  if [ "$skip_macos" -eq 1 ]; then
    info "skipping macOS defaults (--skip-macos)"
    macos_defaults_skipped=1
  elif [ "$apply_macos_defaults" -eq 1 ]; then
    bash "$DOT_ROOT/macos/defaults.sh" --yes
  else
    info "skipping macOS defaults (declined earlier, or no controlling terminal)"
    macos_defaults_skipped=1
  fi

  section "Doctor"
  local doctor_status=0
  bash "$DOT_ROOT/scripts/doctor.sh" || doctor_status=$?

  printf '\n'
  if [ "$macos_defaults_skipped" -eq 1 ]; then
    warn "=================================================================="
    warn "macOS system defaults were NOT applied this run. Run: dot macos"
    warn "=================================================================="
  fi
  if [ "$doctor_status" -eq 0 ]; then
    info "bootstrap complete — open a new terminal"
  else
    warn "bootstrap finished, but doctor reports items above that need you."
    warn "On a fresh machine this is expected: the two machine-local files were"
    warn "created from templates and still hold placeholder values."
    warn "Fill in ~/.config/git/local and ~/.config/zsh/local.zsh, then: dot doctor"
  fi
  return "$doctor_status"
}

# bootstrap_local_file <example> <destination>
# Copies the template only when the destination does not exist, so the
# install stays unattended and never overwrites real secrets.
bootstrap_local_file() {
  local example="$1" dest="$2"
  if [ -f "$dest" ]; then
    info "$dest already exists"
    return
  fi
  mkdir -p "$(dirname "$dest")"
  cp "$example" "$dest"
  warn "created $dest from the template — fill it in"
}

cmd_update() {
  [ "$#" -eq 0 ] || die "dot update accepts no options (got: $1)"

  section "Homebrew"
  brew update
  brew upgrade
  brew bundle --file="$DOT_ROOT/homebrew/Brewfile"

  section "Shell plugins"
  sheldon lock --update

  section "Runtimes"
  mise upgrade

  section "tmux plugins"
  if [ -x "$HOME/.config/tmux/plugins/tpm/bin/update_plugins" ]; then
    "$HOME/.config/tmux/plugins/tpm/bin/update_plugins" all
  fi

  section "Neovim plugins"
  nvim --headless "+Lazy! sync" +qa

  section "Doctor"
  local doctor_status=0
  bash "$DOT_ROOT/scripts/doctor.sh" || doctor_status=$?

  printf '\n'
  if [ "$doctor_status" -eq 0 ]; then
    info "update complete — review and commit the lock files:"
  else
    warn "update finished, but doctor reports items above that need you."
  fi
  printf '  packages/nvim/.config/nvim/lazy-lock.json\n'
  return "$doctor_status"
}

main "$@"
